body {
  font-family: Arial, Helvetica, sans-serif;
  background-color: white;
  color: #222;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  margin: 0;
  transition: 0.3s;
}

h1 {
  margin-bottom: 20px;
}

input {
  width: 250px;
  padding: 12px;
  margin: 8px 0;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 16px;
}

div {
  margin-top: 15px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
}

button {
  padding: 12px 18px;
  border: none;
  border-radius: 8px;
  background-color: #007bff;
  color: white;
  cursor: pointer;
  font-size: 15px;
  transition: 0.3s;
}

button:hover {
  opacity: 0.85;
}

#resultado {
  margin-top: 25px;
  font-size: 20px;
  font-weight: bold;
}

.dark {
  background-color: #121212;
  color: white;
}

.dark input {
  background-color: #222;
  color: white;
  border: 1px solid #555;
}